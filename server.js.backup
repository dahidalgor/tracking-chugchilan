const express = require('express');
const fs = require('fs');
const path = require('path');

const app = express();
const PORT = 3000;

// Middleware para parsear JSON
app.use(express.json());

// Servir archivos estáticos desde frontend
app.use(express.static(path.join(__dirname, 'frontend')));

// Endpoint para obtener guías
app.get('/api/guides', (req, res) => {
  const guidesPath = path.join(__dirname, 'frontend', 'data', 'guides', 'guides.json');
  fs.readFile(guidesPath, 'utf8', (err, data) => {
    if (err) {
      return res.status(500).json({ error: 'Error reading guides' });
    }
    res.json(JSON.parse(data));
  });
});

// Endpoint para agregar un guía
app.post('/api/guides', (req, res) => {
  const newGuide = req.body;
  const guidesPath = path.join(__dirname, 'frontend', 'data', 'guides', 'guides.json');

  fs.readFile(guidesPath, 'utf8', (err, data) => {
    if (err) {
      return res.status(500).json({ error: 'Error reading guides' });
    }
    const guidesData = JSON.parse(data);
    // Asignar ID
    newGuide.id = Math.max(...guidesData.guides.map(g => g.id), 0) + 1;
    guidesData.guides.push(newGuide);

    fs.writeFile(guidesPath, JSON.stringify(guidesData, null, 2), 'utf8', (err) => {
      if (err) {
        return res.status(500).json({ error: 'Error saving guide' });
      }
      res.json({ success: true, guide: newGuide });
    });
  });
});

app.listen(PORT, () => {
  console.log(`Server running on http://localhost:${PORT}`);
});